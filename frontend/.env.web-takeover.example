# ============================================================================
# Kaki Learning Frontend — Web Takeover Mock Environment Template
# Generated 2026-08-05 by KAKI-WEB-TAKEOVER-PACKAGE-02.
#
# SAFETY RULE: values are mock / isolated-local only. Nothing is copied from
# the formal frontend/.env.local. The takeover runner copies this file to
# frontend/.env inside the isolated directory before starting vite so the
# dev server and build pick it up (vite loadEnv reads .env files from cwd).
# ============================================================================

# Dev proxy target: vite proxies /api here when the dev server runs.
VITE_API_PROXY_TARGET=http://127.0.0.1:18001

# API base used by axios (fallback when proxy not used). Isolated-local only.
VITE_API_BASE_URL=http://127.0.0.1:18001

# Browser-facing API base (used directly by the AI workspace runtime scripts).
VITE_BROWSER_API_BASE_URL=http://127.0.0.1:18001

# real = formal production data mode; mock = isolated synthetic/mock mode.
VITE_DATA_MODE=mock

# BrowserRouter basename. Keep "/" for the takeover default.
VITE_BASE_PATH=/
