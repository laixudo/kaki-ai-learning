# ============================================================================
# Kaki Learning — Web Takeover Mock Environment Template
# Generated 2026-08-05 by KAKI-WEB-TAKEOVER-PACKAGE-02 (READ_ONLY packaging).
#
# SAFETY RULE: none of these values come from the formal .env / .env.example.
# They are empty strings, obvious fictional placeholders, or isolated-local
# mock values only. Do NOT copy any real value from the formal project.
#
# The takeover runner (takeover_tools/run_backend.py or run-web-takeover.*)
# resolves the actual values (absolute path to the synthetic DB, ports
# 18001/15174) at runtime inside the isolated directory. Nothing here is a
# real secret. For production the human operator must fill the REQUIRED
# fields themselves (see ENVIRONMENT-VARIABLE-CATALOG.md).
# ============================================================================

# --- Run mode ---------------------------------------------------------------
# mock: no external LLM, no external infra, isolated local only.
MODE=mock
DEBUG=false

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=18001

# --- Database (synthetic, created from scratch by takeover_tools) -----------
# DB_ENGINE=sqlite keeps get_build_db_url() == DATABASE_URL. The runner
# overwrites DATABASE_URL with an absolute path to the synthetic DB located
# at <isolated-root>/backend/ml_learning.synthetic.db.
DB_ENGINE=sqlite
DATABASE_URL=sqlite+aiosqlite:///./backend/ml_learning.synthetic.db

# --- LLM (mock provider only; never dials out) ------------------------------
LLM_PROVIDER=mock
LLM_MODEL=mock
LLM_TIMEOUT_SEC=30

# --- External LLM keys (left empty in mock mode) ----------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=http://127.0.0.1:9
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
XUNFEI_API_KEY=
XUNFEI_APP_ID=
XUNFEI_API_SECRET=
XUNFEI_API_PASSWORD=
ANTHROPIC_AUTH_TOKEN=REPLACE_WITH_OPTIONAL_TOKEN
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=http://127.0.0.1:9
SEEDANCE_ENABLED=false

# --- JWT --------------------------------------------------------------------
# Mock mode only. Production MUST set a 32-byte strong random value via env.
SECRET_KEY=web-takeover-mock-dev-only-do-not-use-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- External infra (disabled for isolated replay; avoids 50s startup waits)--
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=false
MILVUS_URI=http://127.0.0.1:19530
MILVUS_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin-placeholder
MINIO_SECRET_KEY=minioadmin-placeholder
MINIO_SECURE=false
MINIO_ENABLED=false
OPENMAIC_BASE_URL=http://127.0.0.1:3001
OPENMAIC_ENABLED=false

# --- Initial admin (documentation only; the synthetic DB is seeded directly
# --- by takeover_tools/create_synthetic_database.py) ------------------------
INITIAL_ADMIN_USERNAME=web_takeover_admin
INITIAL_ADMIN_PASSWORD=KakiAdminMock-2026!
INITIAL_ADMIN_DISPLAY_NAME=网页接管合成管理员
